# Hostinger (Apache/LiteSpeed). Case-study URLs are real folders in dist/
# (work/<slug>/index.html), so deep links work without any rewrites. This
# only sends unknown URLs to the app's own not-found page, with a 404 status.
ErrorDocument 404 /404.html

# One address for the site: www.beyondyears.co.uk sends visitors (and search
# engines) on to beyondyears.co.uk, keeping the rest of the URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.beyondyears\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://beyondyears.co.uk/$1 [R=301,L]
</IfModule>

# Basic security headers on every response
<IfModule mod_headers.c>
  # Always use HTTPS for this address for a year (subdomains such as webmail
  # are left alone)
  Header always set Strict-Transport-Security "max-age=31536000"
  # Browsers use each file as the type the server says, never a guessed one
  Header always set X-Content-Type-Options "nosniff"
  # Other sites can't show these pages inside a frame (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Links to other sites pass on only the domain, not the full page address
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# How long browsers keep files, so return visits don't download them again.
<IfModule mod_headers.c>
  # Pages: always check for a newer copy, so a new upload shows up straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images and fonts keep the same name between uploads, so a month. Replacing
  # one under the same name can take up to that long to reach repeat visitors;
  # give it a new name if it needs to show up at once.
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Scripts and styles only come from the build (dist/assets/), which gives
  # them a new name every time they change, so they can be kept for a year
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
