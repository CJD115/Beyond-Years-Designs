# Hostinger (Apache/LiteSpeed). Case-study URLs are real folders in dist/
# (work/<slug>/index.html), so deep links work without any rewrites. This
# only sends unknown URLs to the app's own not-found page, with a 404 status.
ErrorDocument 404 /404.html

# How long browsers keep files, so return visits don't download them again.
<IfModule mod_headers.c>
  # Pages: always check for a newer copy, so a new upload shows up straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images and fonts keep the same name between uploads, so a month. Replacing
  # one under the same name can take up to that long to reach repeat visitors;
  # give it a new name if it needs to show up at once.
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Scripts and styles only come from the build (dist/assets/), which gives
  # them a new name every time they change, so they can be kept for a year
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
