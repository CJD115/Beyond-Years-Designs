# Copy to .env.local and fill in. Vite bakes VITE_* values into the built JS,
# so these are public once deployed; .env.local just keeps them out of git.

# Contact form (src/components/studio/FinalCTA.jsx). Create the key at
# https://web3forms.com with the inbox enquiries should go to. The Hostinger
# build is made locally, so .env.local is all it needs.
VITE_WEB3FORMS_ACCESS_KEY=
